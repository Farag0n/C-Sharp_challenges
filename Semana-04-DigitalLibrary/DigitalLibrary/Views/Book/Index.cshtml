@model IEnumerable<DigitalLibrary.Models.Book>
@{
    ViewData["Title"] = "Lista de libros";
    Layout = "_Layout";
}

<h1>Lista de libros</h1>

<p>
    <a class="btn btn-primary" href="@Url.Action("Create", "Book")">Crear libro</a>
</p>

@if(ViewBag.Error != null) {
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<table class="table">
    <thead>
    <tr>
        <th>Id</th>
        <th>Nombre</th>
        <th>Autor</th>
        <th>Publicado</th>
        <th>Stock</th>
        <th>Acciones</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var b in Model)
    {
        <tr>
            <td>@b.ID</td>
            <td>@b.Name</td>
            <td>@b.Writer</td>
            <td>@b.Relased.ToString("yyyy-MM-dd")</td>
            <td>@b.Stock</td>
            <td>
                <a class="btn btn-sm btn-secondary" href="@Url.Action("Edit","Book", new { id = b.ID })">Editar</a>
                <a class="btn btn-sm btn-danger" href="@Url.Action("Delete","Book", new { id = b.ID })">Eliminar</a>
            </td>
        </tr>
    }
    </tbody>
</table>