@model DigitalLibrary.Models.User
@{
    ViewData["Title"] = "Eliminar usuario";
    Layout = "_Layout";
}

<h1>Eliminar usuario</h1>

<p>¿Estás seguro que deseas eliminar al usuario <strong>@Model.Name</strong> (ID: @Model.ID)?</p>

<a class="btn btn-danger" href="@Url.Action("ConfirmDelete","User", new { id = Model.ID })">Sí, eliminar</a>
<a class="btn btn-secondary" href="@Url.Action("Index","User")">Cancelar</a>