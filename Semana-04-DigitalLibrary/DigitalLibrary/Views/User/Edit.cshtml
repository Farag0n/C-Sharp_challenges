@model DigitalLibrary.Models.User

<h2>Editar Usuario</h2>

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="ID" />
    <div class="form-group">
        <label>Nombre</label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Documento</label>
        <input asp-for="DocNumber" class="form-control" />
        <span asp-validation-for="DocNumber" class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Correo</label>
        <input asp-for="Email" class="form-control" />
    </div>

    <div class="form-group">
        <label>Teléfono</label>
        <input asp-for="CelNumber" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">Guardar Cambios</button>
    <a href="@Url.Action("Index")" class="btn btn-secondary">Volver</a>
</form>