@model DigitalLibrary.Models.User
@{
    ViewData["Title"] = "Editar usuario";
    Layout = "_Layout";
}

<h1>Editar usuario</h1>

@if(ViewBag.Error != null) {
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<form method="get" action="@Url.Action("SaveEdit","User")">
    <!-- incluimos el id en los parámetros -->
    <input type="hidden" name="id" value="@Model.ID" />

    <div class="mb-3">
        <label class="form-label">Nombre</label>
        <input name="name" class="form-control" value="@Model.Name" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Edad</label>
        <input name="age" type="number" class="form-control" value="@Model.Age" />
    </div>
    <div class="mb-3">
        <label class="form-label">Número de documento</label>
        <input name="docNumber" class="form-control" value="@Model.DocNumber" />
    </div>
    <div class="mb-3">
        <label class="form-label">Email</label>
        <input name="email" type="email" class="form-control" value="@Model.Email" />
    </div>
    <div class="mb-3">
        <label class="form-label">Celular</label>
        <input name="celNumber" type="number" class="form-control" value="@Model.CelNumber" />
    </div>

    <button class="btn btn-primary" type="submit">Guardar cambios</button>
    <a class="btn btn-secondary" href="@Url.Action("Index","User")">Cancelar</a>
</form>