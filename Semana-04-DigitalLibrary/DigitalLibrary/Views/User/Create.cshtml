@{
    ViewData["Title"] = "Crear usuario";
    Layout = "_Layout";
}

<h1>Crear usuario</h1>

@if(ViewBag.Error != null) {
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<!-- Formulario con method="get" para evitar HttpPost -->
<form method="get" action="@Url.Action("SaveCreate","User")">
    <div class="mb-3">
        <label class="form-label">Nombre</label>
        <input name="name" class="form-control" required />
    </div>
    <div class="mb-3">
        <label class="form-label">Edad</label>
        <input name="age" type="number" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Número de documento</label>
        <input name="docNumber" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Email</label>
        <input name="email" type="email" class="form-control" />
    </div>
    <div class="mb-3">
        <label class="form-label">Celular</label>
        <input name="celNumber" type="number" class="form-control" />
    </div>

    <button class="btn btn-primary" type="submit">Guardar</button>
    <a class="btn btn-secondary" href="@Url.Action("Index","User")">Cancelar</a>
</form>