@model IEnumerable<DigitalLibrary.Models.User>
@{
    ViewData["Title"] = "Lista de usuarios";
    Layout = "_Layout";
}

<h1>Lista de usuarios</h1>

<p>
    <!-- Enviar a la vista Create (formulario) -->
    <a class="btn btn-primary" href="@Url.Action("Create", "User")">Crear usuario</a>
    <a class="btn btn-primary" href="@Url.Action("Index", "Book")">Ver libros</a>

</p>

@if(ViewBag.Error != null) {
    <div class="alert alert-danger">@ViewBag.Error</div>
}

<table class="table table-striped">
    <thead>
    <tr>
        <th>Id</th>
        <th>Nombre</th>
        <th>Edad</th>
        <th>Documento</th>
        <th>Email</th>
        <th>Celular</th>
        <th>Fecha registro</th>
        <th>Acciones</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var user in Model)
    {
        <tr>
            <td>@user.ID</td>
            <td>@user.Name</td>
            <td>@user.Age</td>
            <td>@user.DocNumber</td>
            <td>@user.Email</td>
            <td>@user.CelNumber</td>
            <td>@user.RegistrationDate.ToString("yyyy-MM-dd")</td>
            <td>
                <a class="btn btn-sm btn-secondary" href="@Url.Action("Edit", "User", new { id = user.ID })">Editar</a>
                <a class="btn btn-sm btn-danger" href="@Url.Action("Delete", "User", new { id = user.ID })">Eliminar</a>
            </td>
        </tr>
    }
    </tbody>
</table>