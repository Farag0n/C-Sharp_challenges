@model IEnumerable<DigitalLibrary.Models.User>

<h2>Usuarios Registrados</h2>

<p>
    <a href="@Url.Action("Create", "User")" class="btn btn-primary">+ Nuevo Usuario</a>
</p>

<table class="table table-striped">
    <thead>
    <tr>
        <th>Nombre</th>
        <th>Documento</th>
        <th>Correo</th>
        <th>Teléfono</th>
        <th>Acciones</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.Name</td>
            <td>@item.DocNumber</td>
            <td>@item.Email</td>
            <td>@item.CelNumber</td>
            <td>
                <a href="@Url.Action("Edit", "User", new { id = item.ID })" class="btn btn-warning btn-sm">Editar</a>
                <a href="@Url.Action("Delete", "User", new { id = item.ID })" class="btn btn-danger btn-sm">Eliminar</a>
            </td>
        </tr>
    }
    </tbody>
</table>